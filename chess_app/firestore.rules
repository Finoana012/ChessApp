rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Invitations ─────────────────────────────────────────────────────────
    // Empêche un utilisateur de s'envoyer une invitation à lui-même
    match /invitations/{invitation} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.toEmail != request.auth.token.email;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // ─── Salles de jeu ───────────────────────────────────────────────────────
    match /rooms/{room} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && (request.resource.data.hostUid == request.auth.uid
            || request.resource.data.guestUid == request.auth.uid);
      allow delete: if request.auth != null
        && resource.data.hostUid == request.auth.uid;
    }

    // ─── Joueurs ─────────────────────────────────────────────────────────────
    match /players/{player} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == player;
    }
  }
}
